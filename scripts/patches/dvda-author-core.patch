@@ -1903,6 +1866,27 @@
 
 // Read numbytes of audio data, and convert it to DVD byte order
 
+inline static void interleave_sample_extended_merged(int channels, int count, uint8_t *buf,
+                                                    int sample_bytes, globalData* globals)
+{
+    if (count == 0) return;
+    if (count < 0 || count > AUDIO_BUFFER_SIZE || channels < 1 || channels > 6 ||
+        (sample_bytes != 2 && sample_bytes != 3) || count % (2 * channels * sample_bytes))
+        EXIT_ON_RUNTIME_ERROR_VERBOSE("Invalid merged PCM buffer size");
+
+    int channel_bytes = count / channels;
+    uint8_t interleaved[count];
+    for (int sample = 0; sample < channel_bytes / sample_bytes; ++sample)
+        for (int channel = 0; channel < channels; ++channel)
+            memcpy(interleaved + (sample * channels + channel) * sample_bytes,
+                   buf + channel * channel_bytes + sample * sample_bytes, sample_bytes);
+    memcpy(buf, interleaved, count);
+    if (sample_bytes == 3)
+        interleave_24_bit_sample_extended(channels, count, buf);
+    else
+        interleave_sample_extended(channels, count, buf);
+}
+
