 int truncate_from_end(char* filename, uint64_t offset)
 {
+#ifdef _WIN32
+    if (offset > INT64_MAX)
+    {
+        errno = EFBIG;
+        return -1;
+    }
+    int fd = _open(filename, _O_WRONLY | _O_BINARY);
+    if (fd == -1) return -1;
+    int result = _chsize_s(fd, (int64_t) offset);
+    int close_result = _close(fd);
+    if (result != 0)
+    {
+        errno = result;
+        return -1;
+    }
+    return close_result;
+#else
     return truncate(filename, offset);
+#endif
 }
 
